# Backend - Environment Variables for Development
# Node.js Port
PORT=3001

# Frontend URLs for CORS
# For local development
FRONTEND_URL=http://localhost:5173

# For production (Vercel frontend)
# FRONTEND_URL=https://nutri-scanner-one.vercel.app

# API Configuration
OPENAI_API_KEY=your_nvidia_or_openai_compatible_key
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=meta/llama-3.2-90b-vision-instruct
NODE_ENV=development
