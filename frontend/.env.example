# Frontend Environment Variables for NutriScan
# Copy this file to .env.local and update values for local development

# Backend API Base URL
# Local development
VITE_API_BASE_URL=http://localhost:3001

# Public frontend URL used for social preview metadata
# Local development
VITE_SITE_URL=http://localhost:5173

# Public absolute image URL for OG/Twitter cards
# Keep this as a 1200x630 image URL in production
VITE_OG_IMAGE_URL=http://localhost:5173/og-image.svg

# Production (Render backend)
# VITE_API_BASE_URL=https://ecoscan-backend.onrender.com
# VITE_SITE_URL=https://your-app.vercel.app
# VITE_OG_IMAGE_URL=https://your-app.vercel.app/og-image.svg
